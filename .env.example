# ============================================================
#  Guyma Cyb — Configuration (aucune clé IA requise)
# ============================================================
#  Le logiciel fonctionne 100% en local, sans aucun service cloud
#  ni IA externe. Toute l'analyse est réalisée par le noyau Rust
#  `shadowscan-core` et les scripts Linux de sécurité embarqués.
# ============================================================

# Port du serveur Express embarqué (3000 par défaut).
PORT=3000

# Identifiant de l'opérateur sécurité par défaut.
DEFAULT_OPERATOR_ID=SEC-OPS-0982

# Chemin vers le noyau Rust compilé.
# - Linux  : shadowscan-core/target/release/shadowscan-core
# - Windows: shadowscan-core/target/release/shadowscan-core.exe
SHADOWSCAN_CORE_PATH=shadowscan-core/target/release/shadowscan-core

# Répertoire des scripts Linux de sécurité (nmap, nikto, whatweb...).
SECURITY_SCRIPTS_DIR=security-scripts

# Répertoire des outils de sécurité installés en user-space (nikto...).
TOOLS_DIR=tools

# Mode sûr par défaut (tests actifs bloqués sauf autorisation opérateur).
SAFE_MODE=true
